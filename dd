WEBHOOK_URL = "https://discord.com/api/webhooks/1533538306384593017/D9W8OC0l2FGmTmnFlA3SG7bEcCopppfJnr-BRLEW6LQvgNzbdWmGAAu8WhUtLSRKgUJm"

ALLOWED_SERVER_ID = 1531712644669505669
ALLOWED_CHANNELS = [1531712645244260504]

client = discord.Client()


async def send_to_webhook(message):
  async with aiohttp.ClientSession() as session:
    webhook = discord.Webhook.from_url(WEBHOOK_URL, session=session)

    avatar_url = message.author.avatar.url if message.author.avatar else None

    files = []
    for attachment in message.attachments:
      files.append(await attachment.to_file())

    content = message.content if message.content else None

    if content or files:
      await webhook.send(
          content=content,
          username=message.author.display_name,
          avatar_url=avatar_url,
          files=files,
      )


@client.event
async def on_ready():
  print(f"Селф-бот запущен на аккаунте: {client.user} (ID: {client.user.id})")


@client.event
async def on_message(message):
  if message.guild is None:
    return
  if message.guild.id != ALLOWED_SERVER_ID:
    return
  if message.channel.id not in ALLOWED_CHANNELS:
    return

  await send_to_webhook(message)


# Передаем только токен, без параметров
client.run(USER_TOKEN)
